    inline constexpr size_t npos = -1;

    class string_view {
    private:
        const char* str_ptr;
        size_t str_len;

    public:
        inline constexpr string_view() : str_ptr(nullptr), str_len(0) {}
        inline constexpr string_view(const char* s, size_t len) : str_ptr(s), str_len(len) {}
        inline string_view(const char* s) : str_ptr(s), str_len(s ? __builtin_strlen(s) : 0) {}

        inline constexpr const char* data() const { return str_ptr; }
        inline constexpr size_t length() const { return str_len; }
        inline constexpr size_t size() const { return str_len; }
        inline constexpr bool empty() const { return str_len == 0; }
        inline constexpr char operator[](size_t idx) const { return str_ptr[idx]; }

        inline size_t find(char c, size_t start = 0) const {
            for (size_t i = start; i < str_len; ++i) if (str_ptr[i] == c) return i;
            return npos;
        }

        inline size_t find(string_view s, size_t start = 0) const {
            if (s.str_len > str_len - start) return npos;
            for (size_t i = start; i <= str_len - s.str_len; ++i) {
                size_t j = 0;
                while (j < s.str_len && str_ptr[i + j] == s.str_ptr[j]) j++;
                if (j == s.str_len) return i;
            }
            return npos;
        }

        inline string_view substr(size_t start, size_t len = npos) const {
            if (start > str_len) return string_view();
            size_t real_len = (len == npos || start + len > str_len) ? str_len - start : len;
            return string_view(str_ptr + start, real_len);
        }

        inline bool operator==(string_view other) const {
            if (str_len != other.str_len) return false;
            return __builtin_memcmp(str_ptr, other.str_ptr, str_len) == 0;
        }
    };

    class string {
    private:
        char* data_ptr;
        size_t len;
        size_t cap;

        inline void reserve_capacity(size_t new_cap) {
            if (new_cap <= cap) return;
            char* new_data = static_cast<char*>(__builtin_operator_new(new_cap));
            if (data_ptr) {
                __builtin_memcpy(new_data, data_ptr, len);
                __builtin_operator_delete(data_ptr);
            }
            data_ptr = new_data;
            cap = new_cap;
        }

    public:
        inline string() : data_ptr(nullptr), len(0), cap(0) {}
        inline string(const char* s) : data_ptr(nullptr), len(0), cap(0) {
            len = __builtin_strlen(s);
            reserve_capacity(len + 1);
            __builtin_memcpy(data_ptr, s, len);
            data_ptr[len] = '\0';
        }
        inline string(const string& o) : data_ptr(nullptr), len(0), cap(0) {
            if (o.len > 0) {
                len = o.len;
                reserve_capacity(len + 1);
                __builtin_memcpy(data_ptr, o.data_ptr, len);
                data_ptr[len] = '\0';
            }
        }
        inline string(string&& o) noexcept : data_ptr(o.data_ptr), len(o.len), cap(o.cap) {
            o.data_ptr = nullptr; o.len = 0; o.cap = 0;
        }
        inline ~string() { if (data_ptr) __builtin_operator_delete(data_ptr); }

        inline const char* c_str() const { return data_ptr ? data_ptr : ""; }
        inline size_t length() const { return len; }
        inline size_t size() const { return len; }
        inline bool empty() const { return len == 0; }
        inline operator string_view() const { return string_view(data_ptr, len); }
    };

    template<typename T>
    class vector {
    private:
        T* arr;
        size_t len;
        size_t cap;

    public:
        inline vector() : arr(nullptr), len(0), cap(0) {}
        inline ~vector() { if (arr) { for (size_t i = 0; i < len; ++i) arr[i].~T(); __builtin_operator_delete(arr); } }

        inline void push_back(const T& val) {
            if (len >= cap) {
                cap = cap == 0 ? 4 : cap * 2;
                T* new_arr = static_cast<T*>(__builtin_operator_new(cap * sizeof(T)));
                for (size_t i = 0; i < len; ++i) new_arr[i] = arr[i];
                if (arr) __builtin_operator_delete(arr);
                arr = new_arr;
            }
            arr[len++] = val;
        }

        inline T& operator[](size_t idx) { return arr[idx]; }
        inline const T& operator[](size_t idx) const { return arr[idx]; }
        inline size_t size() const { return len; }
        inline bool empty() const { return len == 0; }
    };

    struct nullopt_t { constexpr explicit nullopt_t(int) {} };
    inline constexpr nullopt_t nullopt{0};

    template<typename T>
    class optional {
    private:
        char storage[sizeof(T)];
        bool has_value_flag;

    public:
        inline constexpr optional() : has_value_flag(false) {}
        inline constexpr optional(nullopt_t) : has_value_flag(false) {}
        inline optional(const T& val) : has_value_flag(true) { ::new (storage) T(val); }
        
        inline ~optional() { if (has_value_flag) reinterpret_cast<T*>(storage)->~T(); }

        inline constexpr bool has_value() const { return has_value_flag; }
        inline constexpr explicit operator bool() const { return has_value_flag; }

        inline T& value() { return *reinterpret_cast<T*>(storage); }
        inline const T& value() const { return *reinterpret_cast<const T*>(storage); }

        inline T value_or(const T& default_val) const { return has_value_flag ? value() : default_val; }
        inline T* operator->() { return reinterpret_cast<T*>(storage); }
        inline const T* operator->() const { return reinterpret_cast<const T*>(storage); }
        inline T& operator*() { return value(); }
        inline const T& operator*() const { return value(); }
    };

    class ostream {
    public:
        inline ostream& operator<<(const char* s) { __builtin_printf("%s", s); return *this; }
        inline ostream& operator<<(string_view sv) { __builtin_printf("%.*s", (int)sv.length(), sv.data()); return *this; }
        inline ostream& operator<<(const string& s) { __builtin_printf("%s", s.c_str()); return *this; }
        inline ostream& operator<<(int n) { __builtin_printf("%d", n); return *this; }
    };

